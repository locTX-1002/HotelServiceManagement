<Window x:Class="FUHotelManagementWPF.RegisterGuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FU Hotel — Đăng ký tài khoản khách hàng"
        Height="650" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}">
    <Grid Background="{StaticResource SurfaceAltBrush}">
        <Border Width="430" Margin="0,28" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="12"
                Effect="{StaticResource SoftShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tạo tài khoản khách hàng"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Margin="0,6,0,22"
                               Text="Dành cho khách mới chưa có hồ sơ tại FU Hotel."
                               Foreground="{StaticResource InkSoftBrush}" />

                    <TextBlock Text="HỌ TÊN *" Style="{StaticResource FieldLabel}" />
                    <TextBox Margin="0,6,0,14"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <TextBlock Text="SỐ ĐIỆN THOẠI *" Style="{StaticResource FieldLabel}" />
                    <TextBox Margin="0,6,0,14" MaxLength="20"
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <TextBlock Text="EMAIL (KHÔNG BẮT BUỘC)" Style="{StaticResource FieldLabel}" />
                    <TextBox Margin="0,6,0,14" MaxLength="150"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <TextBlock Text="MẬT KHẨU *" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,6,0,5"
                                 PasswordChanged="PasswordInput_PasswordChanged" />
                    <TextBlock Text="{Binding PasswordHint}" FontSize="11.5"
                               TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="XÁC NHẬN MẬT KHẨU *" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ConfirmPasswordInput" Margin="0,6,0,14"
                                 PasswordChanged="ConfirmPasswordInput_PasswordChanged" />

                    <Border Margin="0,0,0,16" Padding="10,8" CornerRadius="4"
                            Background="{StaticResource DangerSoftBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Quay lại đăng nhập"
                                Style="{StaticResource GhostButton}"
                                IsCancel="True" Click="Cancel_Click" />
                        <Button Grid.Column="2" Content="Đăng ký"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Command="{Binding RegisterCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
