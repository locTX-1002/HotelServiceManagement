<UserControl x:Class="FUHotelManagementWPF.Views.Invoices.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:BusinessObjects.Enums;assembly=BusinessObjects"
             xmlns:vm="clr-namespace:FUHotelManagementWPF.ViewModels.Invoices"
             xmlns:mvvm="clr-namespace:FUHotelManagementWPF.MvvmCore"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <vm:VipToVisibilityConverter x:Key="VipToVis" />
    </UserControl.Resources>
    <!-- Khong to Background: nen da co san tu BackdropHost cua cua so. To dac o day
         la che mat anh nen, rieng man Hoa don tro thanh mang mau khac han cac man kia. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Hoá đơn &amp; thanh toán" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Quản lý phụ thu, lập hoá đơn và ghi nhận thanh toán theo lượt ở."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Tải lại" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,10">
                        <TextBlock Text="Lượt ở cần xử lý" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Chọn lượt ở để xem và xử lý hoá đơn."
                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                        <TextBox Style="{StaticResource SearchBox}" Margin="0,10,0,0"
                                 mvvm:SearchBoxAssist.Enable="True"
                                 Text="{Binding StaySearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 ToolTip="Tìm theo phòng, tên khách hoặc mã đặt phòng" />
                        <ComboBox ItemsSource="{Binding StayFilters}" Height="36"
                                  SelectedItem="{Binding SelectedStayFilter}"
                                  DisplayMemberPath="Label" Margin="0,8,0,0"
                                  ToolTip="Lọc theo trạng thái hoá đơn" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ActiveStaysView}"
                             SelectedItem="{Binding SelectedStay}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="Phòng " />
                                                <Run Text="{Binding Reservation.Room.RoomNumber, Mode=OneWay}" />
                                            </TextBlock>
                                            <!-- Cot VIP co do rong co dinh de badge cong no thang hang. -->
                                            <Border Grid.Column="1" Style="{StaticResource BadgeWarning}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Visibility>
                                                    <Binding Path="Reservation.Guest.Tag" Converter="{StaticResource VipToVis}" />
                                                </Border.Visibility>
                                                <TextBlock Text="VIP −10%" />
                                            </Border>
                                            <Border Grid.Column="2" Padding="7,3" CornerRadius="8"
                                                    Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Chưa lập" />
                                                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Invoice.Status}" Value="{x:Static enums:InvoiceStatus.Unpaid}">
                                                                    <Setter Property="Text" Value="Còn nợ" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Invoice.Status}" Value="{x:Static enums:InvoiceStatus.PartiallyPaid}">
                                                                    <Setter Property="Text" Value="Còn nợ" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Invoice.Status}" Value="{x:Static enums:InvoiceStatus.Paid}">
                                                                    <Setter Property="Text" Value="Đã thu" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                            <Run Text="{Binding Reservation.Guest.FullName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ActualCheckIn, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2"
                  Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,9" CornerRadius="8"
                        Background="{StaticResource DangerSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,13"
                        Visibility="{Binding HasSelectedStay, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding InvoiceNumber, Mode=OneWay}"
                                       Style="{StaticResource SectionTitleText}" />
                            <Border Margin="0,6,0,0" Padding="9,4"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrandSoftBrush}"
                                    CornerRadius="10">
                                <TextBlock Text="{Binding InvoiceStatusText, Mode=OneWay}"
                                           Foreground="{StaticResource BrandBrush}"
                                           FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LƯỢT Ở" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding SelectedRoomText, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="  ·  " Foreground="{StaticResource InkSoftBrush}" />
                                <TextBlock Text="{Binding SelectedGuestText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StayPeriodText, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StayPeriodText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="THÔNG TIN LẬP HOÁ ĐƠN" Style="{StaticResource FieldLabel}" />
                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Ngày lập: " />
                                <Run Text="{Binding InvoiceDateText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0">
                                <Run Text="Nhân viên: " />
                                <Run Text="{Binding InvoiceCreatorText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dai canh bao: hoa don trong DB la anh chup luc bam lap, khach goi them
                     dich vu hay bi ghi phu thu sau do thi so tren man hinh van la so cu.
                     Bao ngay tai day thay vi de le tan bam "Tinh lai" moi biet co chenh. -->
                <Border Grid.Row="4" Padding="12,9" CornerRadius="8"
                        Background="{StaticResource WarningSoftBrush}"
                        Visibility="{Binding HasPendingCharges, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding PrepareInvoiceText}"
                                Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="12"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                IsEnabled="{Binding CanPrepareInvoice}"
                                Command="{Binding PrepareInvoiceCommand}" />
                        <TextBlock Text="{Binding PendingChargeText}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}" />
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="6" SelectedIndex="{Binding SelectedTabIndex}"
                            Visibility="Collapsed">
                    <TabItem Header="Hoá đơn">
                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="4,14,4,4">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Bản kê hoá đơn" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="Các khoản đã chốt tại lần lập hoá đơn gần nhất."
                                                       Style="{StaticResource CaptionText}" Margin="0,3,0,14" />

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="KHOẢN THU" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="CHI TIẾT" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="2" Text="THÀNH TIỀN" Style="{StaticResource FieldLabel}"
                                                           TextAlignment="Right" />
                                            </Grid>

                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Tiền phòng" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RoomChargeDetailText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Invoice.RoomCharge, Converter={StaticResource Money}}"
                                                               TextAlignment="Right" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>

                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Dịch vụ" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ServiceChargeDetailText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Invoice.ServiceCharge, Converter={StaticResource Money}}"
                                                               TextAlignment="Right" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>

                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Phụ thu" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SurchargeDetailText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Invoice.SurchargeAmount, Converter={StaticResource Money}}"
                                                               TextAlignment="Right" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>

                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Giảm giá" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DiscountDetailText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Invoice.DiscountAmount, Converter={StaticResource Money}, StringFormat=-{0}}"
                                                               TextAlignment="Right" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="KHUYẾN MÃI" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Promotions}"
                                                      SelectedItem="{Binding SelectedPromotion}"
                                                      DisplayMemberPath="Code"
                                                      IsEditable="True"
                                                      Text="{Binding PromotionCode, UpdateSourceTrigger=PropertyChanged}" />

                                            <!-- GIAM TAY: chi quan ly moi thay o nay. Dung khi khach can bot
                                                 ma chua kip tao ma khuyen mai - go thang so tien roi tinh lai.
                                                 Cong don voi ma khuyen mai va uu dai VIP; tren hoa don se hien
                                                 nhan "TUNHAP" o dong ly do giam. Le tan khong thay o nay, va
                                                 service van chan lai mot lan nua neu co ai goi thang. -->
                                            <StackPanel Visibility="{Binding CanGiveManualDiscount,
                                                                     Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="GIẢM TAY (Đ)" Style="{StaticResource FieldLabel}"
                                                           Margin="0,14,0,0" />
                                                <hc:NumericUpDown Minimum="0" Maximum="500000000" Increment="50000"
                                                                  Value="{Binding ManualDiscount}"
                                                                  ToolTip="Giảm thẳng một số tiền, không cần mã khuyến mãi. Cộng dồn với mã và ưu đãi VIP, tối đa bằng tổng hoá đơn." />
                                            </StackPanel>

                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                                    Margin="0,18,0,0" Padding="0,14,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="Tạm tính" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding InvoiceSubtotal, Mode=OneWay, Converter={StaticResource Money}}"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="Giảm giá" Style="{StaticResource CaptionText}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource SuccessBrush}">
                                                            <Run Text="−" />
                                                            <Run Text="{Binding Invoice.DiscountAmount, Converter={StaticResource Money}}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="Tổng hoá đơn" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Invoice.TotalAmount, Converter={StaticResource Money}}"
                                                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="Đã thanh toán" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding PaidAmount, Converter={StaticResource Money}}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource SuccessBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="12,10" Margin="0,4,0,0" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOutstandingBalance, Mode=OneWay}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="CÒN PHẢI THU" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="{Binding RemainingAmount, Converter={StaticResource Money}}"
                                                               Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOutstandingBalance, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="{Binding PrepareInvoiceText}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,18,0,0"
                                                    IsEnabled="{Binding CanPrepareInvoice}"
                                                    Command="{Binding PrepareInvoiceCommand}" />
                                            <Button Content="Ghi nhận thanh toán"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding CanRecordPayment}"
                                                    Command="{Binding RecordPaymentCommand}" />
                                            <Button Content="Xuất hoá đơn"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding ExportInvoiceCommand}" />
                                            <Button Content="Huỷ hoá đơn"
                                                    Margin="0,8,0,0"
                                                    IsEnabled="{Binding CanCancelInvoice}"
                                                    Command="{Binding CancelInvoiceCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Style="{StaticResource Card}" Margin="4,14,4,4"
                                Visibility="{Binding HasInvoice, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="420">
                                <TextBlock Text="Chưa lập hoá đơn"
                                           Style="{StaticResource SectionTitleText}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedRoomText, Mode=OneWay}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="Các khoản bên dưới là tạm tính theo dữ liệu hiện tại. Hãy kiểm tra trước khi lập hoá đơn."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,18" />
                                <TextBlock Text="TẠM TÍNH" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding LiveTotalText}"
                                           Style="{StaticResource PageTitleText}"
                                           Foreground="{StaticResource BrandBrush}"
                                           HorizontalAlignment="Center" Margin="0,5,0,18" />
                                <Button Content="Lập hoá đơn"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding CanPrepareInvoice}"
                                        Command="{Binding PrepareInvoiceCommand}" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Phụ thu">
                        <Grid Margin="4,14,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Phụ thu của lượt ở" Style="{StaticResource SectionTitleText}" />
                                <Button Content="Thêm phụ thu" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" IsEnabled="{Binding CanEditSurcharges}"
                                        Command="{Binding AddSurchargeCommand}" />
                            </Grid>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Surcharges}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phụ thu"
                                                        Binding="{Binding SurchargeItem.Name}" Width="*" />
                                    <DataGridTextColumn Header="Đơn vị"
                                                        Binding="{Binding SurchargeItem.Unit}" Width="90" />
                                    <DataGridTextColumn Header="Số lượng"
                                                        Binding="{Binding Quantity}" Width="80" />
                                    <DataGridTextColumn Header="Đơn giá"
                                                        Binding="{Binding UnitPriceSnapshot, Converter={StaticResource Money}}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Thành tiền"
                                                        Binding="{Binding Subtotal, Converter={StaticResource Money}}"
                                                        Width="130" />
                                    <DataGridTemplateColumn Header="" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Sửa" Style="{StaticResource GhostButton}"
                                                            Padding="10,5"
                                                            IsEnabled="{Binding DataContext.CanEditSurcharges,
                                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.EditSurchargeCommand,
                                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Xoá" Style="{StaticResource GhostButton}"
                                                            Padding="10,5" Margin="6,0,0,0"
                                                            IsEnabled="{Binding DataContext.CanEditSurcharges,
                                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.DeleteSurchargeCommand,
                                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Thanh toán" IsEnabled="{Binding HasInvoice}">
                        <Grid Margin="4,14,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Lịch sử thanh toán" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Các khoản tiền đã ghi nhận cho hoá đơn này."
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Content="Ghi nhận thanh toán"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{Binding CanRecordPayment}"
                                        Command="{Binding RecordPaymentCommand}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG HOÁ ĐƠN" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Invoice.TotalAmount, Converter={StaticResource Money}}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="ĐÃ THU" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding PaidAmount, Converter={StaticResource Money}}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="CÒN LẠI" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding RemainingAmount, Converter={StaticResource Money}}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="4" ItemsSource="{Binding Payments}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCancelled, Mode=OneWay}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời gian"
                                                        Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Số tiền"
                                                        Binding="{Binding Amount, Converter={StaticResource Money}}"
                                                        Width="130" />
                                    <DataGridTextColumn Header="Phương thức"
                                                        Binding="{Binding MethodText, Mode=OneWay}" Width="130" />
                                    <DataGridTextColumn Header="Mã giao dịch"
                                                        Binding="{Binding TransactionText, Mode=OneWay}" Width="*" MinWidth="140" />
                                    <DataGridTextColumn Header="Trạng thái"
                                                        Binding="{Binding StatusText, Mode=OneWay}" Width="100" />
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Huỷ giao dịch" Padding="10,5"
                                                        Command="{Binding DataContext.VoidPaymentCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsVoidable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource GhostButton}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.CanVoidPayment,
                                                                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                   Value="True" />
                                                                        <Condition Binding="{Binding IsVoidable, Mode=OneWay}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="6" Background="{StaticResource CardBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,4,6,0">
                        <TextBlock Text="Công nợ &amp; lịch sử giao dịch"
                                   Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Theo dõi các khoản đã thu và số tiền còn phải thu của lượt ở."
                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Lập hoá đơn"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding HasInvoice, Mode=OneWay,
                                                     Converter={StaticResource InverseBoolToVis}}"
                                IsEnabled="{Binding CanPrepareInvoice, Mode=OneWay}"
                                Command="{Binding OpenInvoiceDetailCommand}" />
                        <Button Content="Xem hoá đơn"
                                Style="{StaticResource GhostButton}"
                                Visibility="{Binding HasInvoice, Mode=OneWay,
                                                     Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenInvoiceDetailCommand}" />
                        <Button Content="Thêm phụ thu"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding CanEditSurcharges, Mode=OneWay}"
                                Command="{Binding AddSurchargeCommand}" />
                        <Button Content="Ghi nhận thanh toán"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding CanRecordPayment, Mode=OneWay}"
                                Command="{Binding RecordPaymentCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="TỔNG HOÁ ĐƠN" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Invoice.TotalAmount, Mode=OneWay,
                                                         Converter={StaticResource Money}}"
                                           Style="{StaticResource SectionTitleText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="ĐÃ THU" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding PaidAmount, Mode=OneWay,
                                                         Converter={StaticResource Money}}"
                                           Style="{StaticResource SectionTitleText}"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="CÒN PHẢI THU" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding RemainingAmount, Mode=OneWay,
                                                         Converter={StaticResource Money}}"
                                           Style="{StaticResource SectionTitleText}"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="6">
                        <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Visibility="{Binding HasPayments, Mode=OneWay,
                                                       Converter={StaticResource BoolToVis}}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCancelled, Mode=OneWay}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian"
                                                    Binding="{Binding PaymentDate, Mode=OneWay,
                                                                      StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="155" />
                                <DataGridTextColumn Header="Số tiền"
                                                    Binding="{Binding Amount, Mode=OneWay,
                                                                      Converter={StaticResource Money}}"
                                                    Width="130" />
                                <DataGridTextColumn Header="Phương thức"
                                                    Binding="{Binding MethodText, Mode=OneWay}" Width="130" />
                                <DataGridTextColumn Header="Mã giao dịch"
                                                    Binding="{Binding TransactionText, Mode=OneWay}"
                                                    Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding StatusText, Mode=OneWay}" Width="105" />
                                <DataGridTemplateColumn Header="" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Huỷ" Padding="12,5"
                                                    Visibility="{Binding IsVoidable, Mode=OneWay,
                                                                         Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding DataContext.CanVoidPayment,
                                                                        RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                        Mode=OneWay}"
                                                    Command="{Binding DataContext.VoidPaymentCommand,
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButton}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding HasPayments, Mode=OneWay,
                                                     Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="440">
                                <TextBlock Text="Chưa có giao dịch thanh toán"
                                           Style="{StaticResource SectionTitleText}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Khi ghi nhận thanh toán, giao dịch sẽ xuất hiện tại đây để đối chiếu."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,7,0,14" />
                                <TextBlock Text="{Binding RemainingAmount, Mode=OneWay,
                                                         Converter={StaticResource Money}}"
                                           Style="{StaticResource PageTitleText}"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <ProgressBar Grid.RowSpan="7" IsIndeterminate="True" Height="4"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}"
                    Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="430">
                    <TextBlock Text="Không có lượt ở cần xử lý"
                               Style="{StaticResource SectionTitleText}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Các hoá đơn đã thanh toán đầy đủ sẽ không còn xuất hiện trong danh sách này."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,7,0,18" />
                    <Button Content="Tải lại" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
