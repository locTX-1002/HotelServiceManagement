<UserControl x:Class="FUHotelManagementWPF.Views.Permissions.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="Tải lại" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                <Button Content="Lưu phân quyền" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Phân quyền vai trò" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding RoleSubtitle}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Thanh chon vai tro & thanh tim kiem -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <hc:TextBox Width="240" hc:InfoElement.Placeholder="Tìm module, tên quyền..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                hc:InfoElement.ShowClearButton="True" VerticalAlignment="Center" />
                    <Button Content="Chọn tất cả" Command="{Binding SelectAllCommand}" Style="{StaticResource GhostButton}" Margin="10,0,4,0" Padding="10,6" />
                    <Button Content="Bỏ chọn tất cả" Command="{Binding DeselectAllCommand}" Style="{StaticResource GhostButton}" Padding="10,6" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VAI TRÒ HỆ THỐNG:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="DisplayName" Width="220" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GrantedCountText}" Style="{StaticResource CaptionText}"
                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bang danh sach quyen -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredPermissions}" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="CẤP QUYỀN" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110" />
                        <DataGridTextColumn Header="MODULE" Binding="{Binding Module}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="TÊN QUYỀN HẠN" Binding="{Binding DisplayName}" Width="280" IsReadOnly="True" />
                        <DataGridTextColumn Header="MÃ QUYỀN (CODE)" Binding="{Binding Code}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <hc:LoadingCircle HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="* Quyền hạn mới sẽ được áp dụng khi người dùng thuộc vai trò tương ứng đăng nhập lại."
                       Style="{StaticResource CaptionText}" FontSize="12" VerticalAlignment="Center" />
            <Button Content="Lưu phân quyền" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="20,8" />
        </DockPanel>
    </Grid>
</UserControl>
