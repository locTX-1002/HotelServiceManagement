<UserControl x:Class="FUHotelManagementWPF.Views.AuditLogs.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Nhật ký hệ thống" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Tra cứu ai đã thao tác gì trên tài khoản và phân quyền."
                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Khong du quyen: bao mot cau roi dung, khong goi service -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding NoPermission, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}"
                           Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Bạn không có quyền xem nhật ký hệ thống"
                           Style="{StaticResource SectionTitleText}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="Quyền này thuộc về tài khoản quản trị hệ thống."
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thanh loc: khoang ngay + hanh dong + nguoi thao tac -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Từ ngày" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Hành động" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"
                                  DisplayMemberPath="Label" Width="210" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Người thao tác" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Actors}" SelectedItem="{Binding SelectedActor}"
                                  DisplayMemberPath="FullName" Width="200" Margin="0,4,0,0"
                                  hc:InfoElement.Placeholder="Tất cả" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                        <Button Content="Tìm" Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="Bỏ lọc" Command="{Binding ResetFilterCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Canh bao khi dat cap MaxRows -->
            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding IsCapped, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CappedNoticeText}"
                               Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderThickness="0" RowHeight="46" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- THỜI GIAN -->
                            <DataGridTemplateColumn Header="THỜI GIAN" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy  HH:mm'}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- NGƯỜI THAO TÁC -->
                            <DataGridTemplateColumn Header="NGƯỜI THAO TÁC" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Border Width="28" Height="28" CornerRadius="999" Background="{StaticResource BrandSoftBrush}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ActorInitial}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActorName}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding ActorRole}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- HÀNH ĐỘNG & CHI TIẾT THAO TÁC -->
                            <DataGridTemplateColumn Header="HÀNH ĐỘNG &amp; CHI TIẾT THAO TÁC" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActionKind}" Value="Success">
                                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionKind}" Value="Danger">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionKind}" Value="Warning">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionKind}" Value="Info">
                                                                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- KẾT QUẢ -->
                            <DataGridTemplateColumn Header="KẾT QUẢ" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Không có thao tác nào trong khoảng ngày này."
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                               TextAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <hc:LoadingCircle HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="1" Text="{Binding TotalText}" Style="{StaticResource CaptionText}"
                               Margin="16,10" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
