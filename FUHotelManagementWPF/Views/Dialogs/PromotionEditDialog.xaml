<Window x:Class="FUHotelManagementWPF.Views.Dialogs.PromotionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}" Margin="14" Padding="0">
        <StackPanel>
            <Border CornerRadius="4,4,0,0" Padding="20,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEdit}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock Text="MÃ KHUYẾN MÃI" Style="{StaticResource FieldLabel}" />
                <!-- CharacterCasing=Upper: go thuong van thanh in hoa, khop cach service luu -->
                <TextBox CharacterCasing="Upper" MaxLength="30"
                         ToolTip="Ví dụ: HE2026, GIAMTET — tối đa 30 ký tự"
                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="MÔ TẢ (TUỲ CHỌN)" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Ghi ngắn gọn để lễ tân biết áp cho dịp nào" />

                <TextBlock Text="LOẠI GIẢM GIÁ" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="PromotionType" Content="Phần trăm (%)"
                                 VerticalContentAlignment="Center"
                                 IsChecked="{Binding IsPercentage}" />
                    <RadioButton GroupName="PromotionType" Content="Số tiền cố định (đ)"
                                 VerticalContentAlignment="Center" Margin="20,0,0,0"
                                 IsChecked="{Binding IsFixedAmount}" />
                </StackPanel>

                <TextBlock Text="GIÁ TRỊ" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" ToolTip="{Binding ValueHint}"
                             Text="{Binding ValueInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    <!-- Hau to doi theo loai dang chon (% hoac đ) cho khoi nhap nham don vi -->
                    <TextBlock Grid.Column="1" Text="{Binding ValueSuffix}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,2,0" />
                </Grid>

                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NGÀY BẮT ĐẦU" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding StartDate, ValidatesOnNotifyDataErrors=True}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGÀY KẾT THÚC" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding EndDate, ValidatesOnNotifyDataErrors=True}" />
                    </StackPanel>
                </Grid>

                <!-- Khong co ham xoa: bo tick o day chinh la cach ngung dung khuyen mai -->
                <CheckBox Content="Đang áp dụng" Margin="0,14,0,0"
                          IsChecked="{Binding IsActive}"
                          ToolTip="Bỏ tick để ngừng áp dụng mã này (khuyến mãi không xoá được)" />

                <Border Margin="0,14,0,0" CornerRadius="4" Padding="10,8" Background="{StaticResource DangerSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" />
                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            MinWidth="96" IsDefault="True" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
