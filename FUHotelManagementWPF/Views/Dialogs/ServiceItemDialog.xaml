<Window x:Class="FUHotelManagementWPF.Views.Dialogs.ServiceItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}" Margin="14" Padding="0">
        <StackPanel>
            <Border CornerRadius="4,4,0,0" Padding="20,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEdit}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="16.5" />
                    <TextBlock Text="Giá ghi ở đây là giá lúc gọi món. Đổi giá sau này không làm thay đổi các đơn đã lập."
                               Style="{StaticResource CaptionText}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock Text="NHÓM DỊCH VỤ *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="CategoryName" />

                <TextBlock Text="TÊN MÓN *" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="ĐƠN GIÁ (đ) *" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnNotifyDataErrors=True}"
                         ToolTip="Gõ số, ví dụ 50000 hoặc 50.000" />

                <CheckBox Content="Đang bán (lễ tân gọi được món này)" IsChecked="{Binding IsAvailable}"
                          Margin="0,14,0,0" FontSize="12.5" />

                <Border Margin="0,14,0,0" CornerRadius="4" Padding="10,8"
                        Background="{StaticResource DangerSoftBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" />
                    <Button Content="Lưu món" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            MinWidth="110" IsDefault="True" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
