<Window x:Class="FUHotelManagementWPF.Views.Dialogs.CreateGuestAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}" Margin="14" Padding="0">
        <StackPanel>
            <Border CornerRadius="4,4,0,0" Padding="20,15" Background="{StaticResource BrandSoftBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="16.5" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock Text="HỌ TÊN" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="SỐ ĐIỆN THOẠI" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         ToolTip="Số điện thoại này cũng là tên đăng nhập của khách" />

                <TextBlock Text="EMAIL (TUỲ CHỌN)" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}" Padding="12,9" />

                <TextBlock Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <PasswordBox x:Name="ConfirmInput" Style="{StaticResource InputPasswordBox}" Padding="12,9" />

                <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource CaptionText}"
                           FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                <!-- Banner loi tu service (SDT trung, mat khau yeu, mat ket noi...) -->
                <Border Margin="0,14,0,0" CornerRadius="4" Padding="10,8" Background="{StaticResource DangerSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" />
                    <Button Content="Tạo tài khoản" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            MinWidth="96" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
