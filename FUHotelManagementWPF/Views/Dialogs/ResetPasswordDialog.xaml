<Window x:Class="FUHotelManagementWPF.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}"
            Margin="16" Padding="26,22">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="Đặt mật khẩu mới cho " /><Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Nhân viên sẽ đăng nhập bằng email " /><Run Text="{Binding Email, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" và mật khẩu này." />
            </TextBlock>

            <TextBlock Text="MẬT KHẨU MỚI" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}" />

            <TextBlock Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
            <PasswordBox x:Name="ConfirmInput" Style="{StaticResource InputPasswordBox}" />

            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource CaptionText}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- Banner loi: nhap lech hoac mat khau chua du manh (cau chu do service tra ve) -->
            <Border Margin="0,14,0,0" CornerRadius="4" Padding="10,8"
                    Background="{StaticResource DangerSoftBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>
            </Border>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" />
                <Button Content="Đặt lại" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        MinWidth="110" IsDefault="True" Click="Reset_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
