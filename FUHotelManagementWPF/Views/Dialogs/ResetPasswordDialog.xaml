<Window x:Class="FUHotelManagementWPF.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}"
            Margin="16" Padding="28,24">
        <StackPanel>
            <!-- Header với Icon Badge -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrandSoftBrush}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IconText}" FontSize="18"
                               Foreground="{StaticResource BrandDarkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="17" />
                    <TextBlock Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                        <Run Text="Tài khoản: " /><Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="18">
                <Run Text="Nhân viên sẽ đăng nhập bằng email " /><Run Text="{Binding Email, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" và mật khẩu mới này." />
            </TextBlock>

            <!-- Ô Nhập Mật Khẩu Mới + Mắt Toggle -->
            <TextBlock Text="MẬT KHẨU MỚI" Style="{StaticResource FieldLabel}" Margin="0,4,0,5" />
            <Grid Margin="0,0,0,12">
                <PasswordBox x:Name="PasswordInput" Padding="12,9,42,9"
                             PasswordChanged="PasswordInput_PasswordChanged">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <TextBox x:Name="PlainPasswordInput" Style="{StaticResource InputBox}" Padding="12,9,42,9"
                         TextChanged="PlainPasswordInput_TextChanged"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="34" Height="32" Margin="0,0,4,0"
                        Cursor="Hand" Focusable="False"
                        Command="{Binding TogglePasswordCommand}"
                        ToolTip="Hiện / ẩn mật khẩu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Foreground="{StaticResource InkSoftBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="Text" Value="&#xE7B3;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Text" Value="&#xED1A;" />
                                        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- Ô Xác Nhận Mật Khẩu + Mắt Toggle -->
            <TextBlock Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <Grid>
                <PasswordBox x:Name="ConfirmInput" Padding="12,9,42,9"
                             PasswordChanged="ConfirmInput_PasswordChanged">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <TextBox x:Name="PlainConfirmInput" Style="{StaticResource InputBox}" Padding="12,9,42,9"
                         TextChanged="PlainConfirmInput_TextChanged"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="34" Height="32" Margin="0,0,4,0"
                        Cursor="Hand" Focusable="False"
                        Command="{Binding TogglePasswordCommand}"
                        ToolTip="Hiện / ẩn mật khẩu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Foreground="{StaticResource InkSoftBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="Text" Value="&#xE7B3;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Text" Value="&#xED1A;" />
                                        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource CaptionText}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InkSoftBrush}" />

            <!-- Banner Lỗi -->
            <Border Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                    Background="{StaticResource DangerSoftBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" MaxWidth="320" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" Padding="18,8" />
                <Button Content="Đặt lại" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Padding="22,8" MinWidth="110" IsDefault="True" Click="Reset_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
