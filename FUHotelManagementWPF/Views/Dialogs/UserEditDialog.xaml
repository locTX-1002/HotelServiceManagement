<Window x:Class="FUHotelManagementWPF.Views.Dialogs.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <Border Style="{StaticResource Card}" Effect="{StaticResource SoftShadowLarge}" Margin="14" Padding="0">
        <StackPanel>
            <Border CornerRadius="4,4,0,0" Padding="20,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEdit}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="16.5" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock Text="HỌ TÊN" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         ToolTip="Email này cũng là tên đăng nhập của nhân viên" />

                <TextBlock Text="GIỚI TÍNH" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding SelectedGender}"
                          DisplayMemberPath="Label" />

                <TextBlock Text="VAI TRÒ" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                          DisplayMemberPath="Label" />

                <!-- Mat khau chi dat luc tao moi; sua tai khoan thi dung chuc nang
                     "Dat lai mat khau" ben ngoai cho ro rang. -->
                <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="PasswordInput" Padding="12,9,42,9"
                                     PasswordChanged="PasswordInput_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox x:Name="PlainPasswordInput" Style="{StaticResource InputBox}" Padding="12,9,42,9"
                                 TextChanged="PlainPasswordInput_TextChanged"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="34" Height="32" Margin="0,0,4,0"
                                Cursor="Hand" Focusable="False"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="Hiện / ẩn mật khẩu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Foreground="{StaticResource InkSoftBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                        <Setter Property="FontSize" Value="15" />
                                        <Setter Property="Text" Value="&#xE7B3;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                <Setter Property="Text" Value="&#xED1A;" />
                                                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TextBlock Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <Grid>
                        <PasswordBox x:Name="ConfirmInput" Padding="12,9,42,9"
                                     PasswordChanged="ConfirmInput_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox x:Name="PlainConfirmInput" Style="{StaticResource InputBox}" Padding="12,9,42,9"
                                 TextChanged="PlainConfirmInput_TextChanged"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="34" Height="32" Margin="0,0,4,0"
                                Cursor="Hand" Focusable="False"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="Hiện / ẩn mật khẩu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Foreground="{StaticResource InkSoftBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                        <Setter Property="FontSize" Value="15" />
                                        <Setter Property="Text" Value="&#xE7B3;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                <Setter Property="Text" Value="&#xED1A;" />
                                                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource CaptionText}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Banner loi tu service (email trung, mat khau yeu, mat ket noi...) -->
                <Border Margin="0,14,0,0" CornerRadius="4" Padding="10,8" Background="{StaticResource DangerSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Huỷ" Style="{StaticResource GhostButton}" IsCancel="True" />
                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            MinWidth="96" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
