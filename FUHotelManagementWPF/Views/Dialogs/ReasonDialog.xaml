<Window x:Class="FUHotelManagementWPF.Views.Dialogs.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập lý do" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="Lý do sẽ được lưu trong lịch sử phê duyệt."
                       Style="{StaticResource CaptionText}" Margin="0,6,0,14" />
            <TextBox x:Name="ReasonText" MinHeight="90" MaxLength="500"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                       Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Đóng" Style="{StaticResource GhostButton}" IsCancel="True" />
                <Button Content="Gửi yêu cầu" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" IsDefault="True" Click="Submit_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
