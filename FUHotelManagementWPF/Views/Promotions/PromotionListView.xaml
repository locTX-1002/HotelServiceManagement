<UserControl x:Class="FUHotelManagementWPF.Views.Promotions.PromotionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vmPromo="clr-namespace:FUHotelManagementWPF.ViewModels.Promotions">
    <UserControl.Resources>
        <!-- Badge trang thai: mac dinh Neutral (Het han), doi mau theo Status -->
        <Style x:Key="PromotionStatusBadge" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vmPromo:PromotionStatus.Running}">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vmPromo:PromotionStatus.Upcoming}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vmPromo:PromotionStatus.Off}">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chip loc: chip dang chon in dam + mau thuong hieu de biet dang loc gi.
             Moi chip mot style vi Style khong nhan tham so. -->
        <Style x:Key="ChipAll" TargetType="Button" BasedOn="{StaticResource QuickChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Filter}" Value="{x:Static vmPromo:PromotionFilter.All}">
                    <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRunning" TargetType="Button" BasedOn="{StaticResource QuickChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Filter}" Value="{x:Static vmPromo:PromotionFilter.Running}">
                    <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipExpired" TargetType="Button" BasedOn="{StaticResource QuickChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Filter}" Value="{x:Static vmPromo:PromotionFilter.Expired}">
                    <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PromotionRowItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Khuyến mãi" Style="{StaticResource PageTitleText}" Margin="0,0,0,12" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="+ Thêm khuyến mãi" Style="{StaticResource PrimaryButton}"
                    Padding="16,8" Command="{Binding AddCommand}"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         ToolTip="Tìm theo mã hoặc mô tả khuyến mãi" />
                <Button Content="Tất cả" Style="{StaticResource ChipAll}" Margin="14,0,6,0"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static vmPromo:PromotionFilter.All}" />
                <Button Content="Đang áp dụng" Style="{StaticResource ChipRunning}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static vmPromo:PromotionFilter.Running}" />
                <Button Content="Hết hạn" Style="{StaticResource ChipExpired}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static vmPromo:PromotionFilter.Expired}" />
                <TextBlock Text="{Binding TotalText}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Ghi chu: interface service khong co DeleteAsync nen khong xoa duoc khuyen mai -->
        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Khuyến mãi không xoá được. Muốn ngừng áp dụng thì mở Sửa rồi bỏ tick &quot;Đang áp dụng&quot;." />

        <!-- Trang thai LOI: bao ro + cho tai lai, khong nuot loi -->
        <Border Grid.Row="3" CornerRadius="4" Padding="12,10" Margin="0,0,0,12"
                Background="{StaticResource DangerSoftBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Thử lại" Style="{StaticResource GhostButton}"
                        Padding="14,6" Command="{Binding ReloadCommand}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <hc:LoadingCircle Grid.Row="4" Width="34" Height="34"
                          Foreground="{StaticResource BrandBrush}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <TextBlock Grid.Row="4" Text="Chưa có khuyến mãi nào khớp — đổi bộ lọc, thử từ khoá khác hoặc thêm khuyến mãi mới."
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     ItemContainerStyle="{StaticResource PromotionRowItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Double-click mo thang dialog sua cho nhanh (nut Sua van con ben phai) -->
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- O ky hieu: % hay đ - biet ngay kieu giam ma khong can doc chu -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                    Background="{StaticResource BrandSoftBrush}">
                                <TextBlock Text="{Binding TypeSymbol}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrandDarkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Promotion.Code}" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding DateRangeText}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource PromotionStatusBadge}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                    VerticalAlignment="Top">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,50"
                                TextElement.Foreground="{StaticResource InkSoftBrush}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource IconText}" FontSize="28"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Chọn một khuyến mãi để xem chi tiết" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedRow}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding Promotion.Code}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource PromotionStatusBadge}" HorizontalAlignment="Left"
                                Margin="0,6,0,0">
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="LOẠI GIẢM GIÁ" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="GIÁ TRỊ" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="NGÀY BẮT ĐẦU" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding StartText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="NGÀY KẾT THÚC" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding EndText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="MÔ TẢ" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                        <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14"
                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Sửa khuyến mãi" Style="{StaticResource PrimaryButton}"
                                Padding="16,7" HorizontalAlignment="Left"
                                ToolTip="Đổi giá trị, thời gian hoặc tắt &quot;Đang áp dụng&quot; để ngừng dùng"
                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.EditCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
