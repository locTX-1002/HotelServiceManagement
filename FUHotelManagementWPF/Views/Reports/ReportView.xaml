<UserControl x:Class="FUHotelManagementWPF.Views.Reports.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- The tong quan: card noi tren nen, cach nhau 12px -->
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- O tien trong DataGrid: can PHAI cho de doi chieu con so -->
        <Style x:Key="MoneyCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MoneyHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource AppColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Báo cáo doanh thu" Style="{StaticResource PageTitleText}"
                   Margin="0,0,0,12" />

        <!-- Khong du quyen: bao mot cau roi dung, khong goi service (tranh crash/loi kho hieu) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding NoPermission, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}"
                           Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Bạn không có quyền xem báo cáo"
                           Style="{StaticResource SectionTitleText}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="Chỉ tài khoản Quản trị viên hoặc Quản lý mới xem được số liệu doanh thu."
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Thanh cong cu: khoang ngay + chip chon nhanh + 2 nut hanh dong -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Xem báo cáo" Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Command="{Binding LoadCommand}" />
                    <Button Content="Xuất CSV" Style="{StaticResource GhostButton}"
                            Padding="16,8" Margin="10,0,0,0"
                            ToolTip="Lưu bảng doanh thu ra file CSV mở được bằng Excel"
                            Command="{Binding ExportCsvCommand}" />
                    <Button Content="Xuất PDF" Style="{StaticResource GhostButton}"
                            Padding="16,8" Margin="10,0,0,0"
                            ToolTip="Lưu báo cáo doanh thu ra file PDF"
                            Command="{Binding ExportPdfCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ ngày:" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="2,0,8,0" />
                    <DatePicker Width="140" VerticalAlignment="Center"
                                SelectedDate="{Binding FromDate}" />
                    <TextBlock Text="Đến ngày:" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,8,0" />
                    <DatePicker Width="140" VerticalAlignment="Center"
                                SelectedDate="{Binding ToDate}" />
                    <Button Content="7 ngày" Style="{StaticResource QuickChip}"
                            Margin="16,0,6,0" VerticalAlignment="Center"
                            Command="{Binding Last7DaysCommand}" />
                    <Button Content="30 ngày" Style="{StaticResource QuickChip}"
                            VerticalAlignment="Center" Command="{Binding Last30DaysCommand}" />
                    <Button Content="3 tháng" Style="{StaticResource QuickChip}"
                            VerticalAlignment="Center" Command="{Binding ThisMonthCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- Trang thai LOI: bang bao do, giu nguyen khoang ngay dang chon -->
            <Border Grid.Row="1" Background="{StaticResource DangerSoftBrush}" CornerRadius="4"
                    Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" />
            </Border>

            <!-- 6 the tong quan (margin am de mep phai thang hang voi bang ben duoi) -->
            <UniformGrid Grid.Row="2" Columns="3" Rows="2" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TIỀN PHÒNG" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding RoomRevenue, Converter={StaticResource Money}}"
                                   Style="{StaticResource SectionTitleText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TIỀN DỊCH VỤ" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ServiceRevenue, Converter={StaticResource Money}}"
                                   Style="{StaticResource SectionTitleText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="PHỤ THU" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SurchargeRevenue, Converter={StaticResource Money}}"
                                   Style="{StaticResource SectionTitleText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="GIẢM GIÁ" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding DiscountText}"
                                   Style="{StaticResource SectionTitleText}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TỔNG HOÁ ĐƠN" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding InvoiceRevenue, Converter={StaticResource Money}}"
                                   Style="{StaticResource SectionTitleText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="THỰC THU" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding CollectedAmount, Converter={StaticResource Money}}"
                                   Style="{StaticResource SectionTitleText}"
                                   FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Cong suat phong: so lieu chup tai thoi diem xem, khong theo khoang ngay -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                    Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Công suất phòng hiện tại"
                                   Style="{StaticResource SectionTitleText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="TỔNG SỐ PHÒNG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding TotalRooms}" Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="ĐANG TRỐNG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding AvailableRooms}" Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="ĐÃ ĐẶT" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ReservedRooms}" Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ĐANG Ở" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding OccupiedRooms}" Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TỶ LỆ LẤP ĐẦY" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OccupancyRate, StringFormat={}{0:N1} %}"
                                   Style="{StaticResource SectionTitleText}"
                                   Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Right" />
                        <!-- Thanh tien do: Border nen + Border to mau ben trong, be rong do VM tinh -->
                        <Border Width="{Binding OccupancyBarTrackWidth}" Height="8" CornerRadius="4"
                                Background="{StaticResource SurfaceAltBrush}" Margin="0,8,0,0">
                            <Border HorizontalAlignment="Left" CornerRadius="4"
                                    Width="{Binding OccupancyBarWidth}"
                                    Background="{StaticResource BrandBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bang thuan so lieu -> duoc phep dung DataGrid theo quy uoc giao dien -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DayCountText}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Doanh thu theo ngày"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="44"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                                  RowStyle="{StaticResource AppRowStyle}"
                                  CellStyle="{StaticResource AppCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày" Width="120"
                                                    Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Tiền phòng" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding RoomRevenue, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Dịch vụ" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding ServiceRevenue, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Phụ thu" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding SurchargeRevenue, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Giảm giá" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding DiscountAmount, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Tổng hoá đơn" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding InvoiceRevenue, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Thực thu" Width="*"
                                                    HeaderStyle="{StaticResource MoneyHeader}"
                                                    ElementStyle="{StaticResource MoneyCellText}"
                                                    Binding="{Binding CollectedAmount, Converter={StaticResource Money}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <hc:LoadingCircle Width="34" Height="34"
                                          Foreground="{StaticResource BrandBrush}"
                                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Chưa có hoá đơn nào trong khoảng ngày này — thử chọn khoảng ngày khác."
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Chi tiet hoa don khi chon 1 ngay -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                    Padding="14" Margin="0,12,0,0" MaxHeight="280"
                    Visibility="{Binding HasSelectedDay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding SelectedDayText}"
                               Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DayInvoices}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeight="38"
                              ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                              RowStyle="{StaticResource AppRowStyle}"
                              CellStyle="{StaticResource AppCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="50"
                                                Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Phòng" Width="70"
                                                Binding="{Binding RoomNumber}" />
                            <DataGridTextColumn Header="Tiền phòng" Width="*"
                                                HeaderStyle="{StaticResource MoneyHeader}"
                                                ElementStyle="{StaticResource MoneyCellText}"
                                                Binding="{Binding RoomCharge, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Dịch vụ" Width="*"
                                                HeaderStyle="{StaticResource MoneyHeader}"
                                                ElementStyle="{StaticResource MoneyCellText}"
                                                Binding="{Binding ServiceCharge, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Phụ thu" Width="*"
                                                HeaderStyle="{StaticResource MoneyHeader}"
                                                ElementStyle="{StaticResource MoneyCellText}"
                                                Binding="{Binding SurchargeAmount, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Giảm giá" Width="*"
                                                HeaderStyle="{StaticResource MoneyHeader}"
                                                ElementStyle="{StaticResource MoneyCellText}"
                                                Binding="{Binding DiscountAmount, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Tổng" Width="*"
                                                HeaderStyle="{StaticResource MoneyHeader}"
                                                ElementStyle="{StaticResource MoneyCellText}"
                                                Binding="{Binding TotalAmount, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Trạng thái" Width="110"
                                                Binding="{Binding StatusText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
