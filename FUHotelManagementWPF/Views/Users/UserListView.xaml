<UserControl x:Class="FUHotelManagementWPF.Views.Users.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:FUHotelManagementWPF.MvvmCore"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- Badge vai trò -->
        <Style x:Key="RoleBadge" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
            <Setter Property="MinWidth" Value="104" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RoleName}" Value="Admin">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RoleName}" Value="Manager">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RoleName}" Value="Receptionist">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Badge trạng thái -->
        <Style x:Key="UserStatusBadge" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
            <Setter Property="MinWidth" Value="104" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chip lọc vai trò -->
        <Style x:Key="RoleFilterChip" TargetType="Button" BasedOn="{StaticResource QuickChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UserRowItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <!-- Không có quyền xem -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding NoUserAccess, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="26"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Bạn không có quyền vào mục này" Style="{StaticResource SectionTitleText}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="Mục này dành cho tài khoản quản trị hệ thống. Liên hệ quản trị viên nếu bạn cần thao tác ở đây."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Người dùng" Style="{StaticResource PageTitleText}" Margin="0,0,0,12" />

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <!-- Cụm 2 nút hành động chính bên phải -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="+ Thêm tài khoản" Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Command="{Binding AddCommand}"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" />
                    <Button Content="+ Tài khoản khách" Style="{StaticResource GhostButton}"
                            Padding="16,8" Command="{Binding CreateGuestAccountCommand}"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="userSearch" Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             ToolTip="Tìm theo họ tên hoặc email" />
                    <Button Style="{StaticResource SearchButton}"
                            mvvm:SearchBoxAssist.SubmitFor="{Binding ElementName=userSearch}" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource CaptionText}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Vai trò:" Style="{StaticResource CaptionText}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="2,0,8,0" />
                <ItemsControl ItemsSource="{Binding RoleFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource RoleFilterChip}"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.FilterRoleCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Trạng thái đang tải -->
            <hc:LoadingCircle Grid.Row="3" Width="34" Height="34"
                              Foreground="{StaticResource BrandBrush}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Trạng thái rỗng -->
            <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="32" Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Không tìm thấy tài khoản nhân viên nào" Style="{StaticResource SectionTitleText}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="Thử thay đổi từ khoá tìm kiếm hoặc bỏ chọn lọc vai trò hiện tại." Style="{StaticResource CaptionText}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Button Content="Bỏ bộ lọc" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,6" Command="{Binding ClearFilterCommand}" />
                </StackPanel>
            </Border>

            <!-- Trạng thái lỗi -->
            <Border Grid.Row="3" Background="{StaticResource DangerSoftBrush}" CornerRadius="4"
                    Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" MaxWidth="380" VerticalAlignment="Center" />
                    <Button Content="Thử lại" Style="{StaticResource GhostButton}" Margin="14,0,0,0"
                            Padding="14,6" Command="{Binding ReloadCommand}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                         ItemContainerStyle="{StaticResource UserRowItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Avatar chữ cái đầu -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="999"
                                        Background="{StaticResource BrandSoftBrush}">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource BrandDarkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Email}" Style="{StaticResource CaptionText}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource RoleBadge}"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding RoleDisplay}" />
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource UserStatusBadge}"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>

                                <!-- Nút thao tác nhanh trên từng dòng -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.CanManageUsers,
                                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                                      Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource IconGhostButton}" ToolTip="Sửa thông tin tài khoản"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconGhostButton}" ToolTip="Đặt lại mật khẩu"
                                            Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0">
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource IconText}" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconGhostButton}" ToolTip="{Binding ToggleActiveToolTip}"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanToggleActive}">
                                        <TextBlock FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                    <Setter Property="Text" Value="&#xE72E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="&#xE785;" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource SoftShadow}"
                        VerticalAlignment="Top" Padding="18">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,50"
                                    TextElement.Foreground="{StaticResource InkSoftBrush}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" FontSize="28"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Chọn một tài khoản để xem chi tiết" Style="{StaticResource CaptionText}"
                                       FontSize="12.5" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel DataContext="{Binding SelectedRow}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="999" Background="{StaticResource BrandSoftBrush}">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="20"
                                               Foreground="{StaticResource BrandDarkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource SectionTitleText}" FontSize="17" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource RoleBadge}">
                                            <TextBlock Text="{Binding RoleDisplay}" />
                                        </Border>
                                        <Border Style="{StaticResource UserStatusBadge}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />

                            <TextBlock Text="EMAIL ĐĂNG NHẬP" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,10" />

                            <TextBlock Text="VAI TRÒ HỆ THỐNG" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding RoleDisplay}" FontWeight="SemiBold" Margin="0,2,0,10" />

                            <TextBlock Text="TRẠNG THÁI TÀI KHOẢN" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,2,0,0" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14" />

                            <StackPanel Orientation="Vertical">
                                <Button Content="Sửa thông tin" Style="{StaticResource PrimaryButton}"
                                        Padding="16,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Đặt lại mật khẩu" Style="{StaticResource GhostButton}"
                                        Padding="16,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                        ToolTip="Đặt mật khẩu mới cho tài khoản này"
                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{Binding ToggleActiveText}"
                                        Style="{StaticResource GhostButton}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="16,8" HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding CanToggleActive}"
                                        ToolTip="{Binding ToggleActiveToolTip}"
                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="4" Padding="12,10" Margin="0,10,0,0"
                                    Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource InfoBrush}"
                                           Text="Bạn đang đăng nhập bằng tài khoản này. Để đảm bảo an toàn, hệ thống không cho phép tự khoá phiên làm việc hiện tại." />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>