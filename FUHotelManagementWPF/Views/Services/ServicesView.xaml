<UserControl x:Class="FUHotelManagementWPF.Views.Services.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- Chip trang thai don: mau doi theo trang thai de nhin phat ra ngay -->
        <Style x:Key="OrderBadge" TargetType="Border" BasedOn="{StaticResource BadgeColumn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Pending">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Processing">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Completed">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemBadge" TargetType="Border" BasedOn="{StaticResource BadgeColumn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dịch vụ" Style="{StaticResource PageTitleText}" Margin="0,0,0,12" />

        <TabControl Grid.Row="1">
            <!-- ============================ TAB GỌI DỊCH VỤ ============================ -->
            <TabItem Header="Gọi dịch vụ">
                <Grid x:Name="OrdersRoot" Margin="4,14,4,4" DataContext="{Binding Orders}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: phòng đang có khách ở -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="PHÒNG ĐANG CÓ KHÁCH"
                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />

                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Không có phòng nào đang có khách ở. Nhận phòng cho khách trước rồi mới gọi dịch vụ được."
                                   Style="{StaticResource CaptionText}" FontSize="12.5"
                                   Visibility="{Binding NoStay, Converter={StaticResource BoolToVis}}" />

                        <ListBox ItemsSource="{Binding Stays}" SelectedItem="{Binding SelectedStay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="11,9" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                                 RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding RoomNumber, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" /><Run
                                                Text=" · " Foreground="{StaticResource InkSoftBrush}" /><Run
                                                Text="{Binding GuestName, Mode=OneWay}" FontSize="13.5" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource CaptionText}"
                                                       FontSize="11.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- CỘT PHẢI: giỏ món + danh sách đơn của phòng đang chọn -->
                    <Grid Grid.Column="2" Visibility="{Binding HasSelectedStay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding SelectedStayTitle}"
                                   Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />

                        <!-- Chọn món rồi thêm vào giỏ -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12"
                                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="THÊM MÓN" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableItems}"
                                              SelectedItem="{Binding PickedItem}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding ServiceName, Mode=OneWay}" /><Run
                                                    Text=" · " Foreground="{StaticResource InkSoftBrush}" /><Run
                                                    Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" đ" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Thêm vào giỏ" Style="{StaticResource GhostButton}"
                                            Padding="14,7" Command="{Binding AddToCartCommand}" />
                                </Grid>

                                <TextBlock Text="Chưa chọn món nào. Chọn ở ô trên rồi bấm Thêm vào giỏ."
                                           Style="{StaticResource CaptionText}" FontSize="12"
                                           Visibility="{Binding CartIsEmpty, Converter={StaticResource BoolToVis}}" />

                                <ItemsControl ItemsSource="{Binding Cart}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <hc:NumericUpDown Grid.Column="1" Width="72" Minimum="1" Maximum="99"
                                                                  Value="{Binding Quantity}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SubtotalText}" FontSize="12.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <Button Grid.Column="3" Content="Bỏ" Style="{StaticResource GhostButton}"
                                                        Padding="9,4" Margin="8,0,0,0" FontSize="11.5"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, ElementName=OrdersRoot}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4,0,10"
                                        Visibility="{Binding CartIsEmpty, Converter={StaticResource InverseBoolToVis}}" />
                                <DockPanel Visibility="{Binding CartIsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="Tạo đơn" Style="{StaticResource PrimaryButton}"
                                            Padding="18,8" MinWidth="120"
                                            IsEnabled="{Binding CanSubmit}" Command="{Binding SubmitCommand}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Tổng: " Foreground="{StaticResource InkSoftBrush}" /><Run
                                        Text="{Binding CartTotalText, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="4" Padding="10,8"
                                Background="{StaticResource DangerSoftBrush}"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Đơn đã gọi của phòng này -->
                        <DockPanel Grid.Row="3" Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="ĐƠN ĐÃ GỌI"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                       Text="Phòng này chưa gọi dịch vụ nào."
                                       Style="{StaticResource CaptionText}" FontSize="12.5"
                                       Visibility="{Binding NoOrder, Converter={StaticResource BoolToVis}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Orders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" BorderThickness="1"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock>
                                                            <Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" /><Run
                                                            Text="  ·  " Foreground="{StaticResource InkSoftBrush}" /><Run
                                                            Text="{Binding TimeText, Mode=OneWay}" FontSize="12" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ItemsText}" Style="{StaticResource CaptionText}"
                                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Style="{StaticResource OrderBadge}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Bắt đầu làm" Style="{StaticResource GhostButton}"
                                                                Padding="11,6" FontSize="12" Margin="0,0,6,0"
                                                                ToolTip="Bếp/nhân viên đã nhận và đang chuẩn bị đơn này"
                                                                Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.StartCommand, ElementName=OrdersRoot}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Hoàn tất" Style="{StaticResource PrimaryButton}"
                                                                Padding="13,6" FontSize="12" Margin="0,0,6,0"
                                                                ToolTip="Chỉ đơn Hoàn tất mới được tính tiền vào hoá đơn"
                                                                Visibility="{Binding ShowComplete, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.CompleteCommand, ElementName=OrdersRoot}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Huỷ" Style="{StaticResource GhostButton}"
                                                                Padding="11,6" FontSize="12"
                                                                Foreground="{StaticResource DangerBrush}"
                                                                Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.CancelOrderCommand, ElementName=OrdersRoot}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="Chọn một phòng bên trái để gọi dịch vụ"
                               Style="{StaticResource CaptionText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedStay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </TabItem>

            <!-- ============================== TAB DANH MỤC ============================== -->
            <TabItem Header="Danh mục">
                <Grid x:Name="CatalogRoot" Margin="4,14,4,4" DataContext="{Binding Catalog}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                            <Button Content="+ Thêm nhóm" Style="{StaticResource GhostButton}"
                                    Padding="14,8" Command="{Binding AddCategoryCommand}" />
                            <Button Content="+ Thêm món" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" Margin="10,0,0,0" Command="{Binding AddItemCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource CaptionText}"
                                   FontSize="12.5" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
                            Background="{StaticResource DangerSoftBrush}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="2" Text="Chưa có món dịch vụ nào. Bấm Thêm nhóm rồi Thêm món."
                               Style="{StaticResource CaptionText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderThickness="1"
                                        BorderBrush="{StaticResource LineBrush}"
                                        CornerRadius="4" Padding="13,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CategoryName}" Style="{StaticResource CaptionText}"
                                                       FontSize="11.5" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="13.5"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,14,0" />

                                        <Border Grid.Column="2" Style="{StaticResource ItemBadge}"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.CanManage, ElementName=CatalogRoot,
                                                                 Converter={StaticResource BoolToVis}}">
                                            <Button Content="Sửa" Style="{StaticResource GhostButton}"
                                                    Padding="13,6" FontSize="12" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.EditItemCommand, ElementName=CatalogRoot}" />
                                            <Button Content="{Binding ToggleText}" Style="{StaticResource GhostButton}"
                                                    Padding="13,6" FontSize="12" MinWidth="86"
                                                    Command="{Binding DataContext.ToggleItemCommand, ElementName=CatalogRoot}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
