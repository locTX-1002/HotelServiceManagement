<UserControl x:Class="FUHotelManagementWPF.Views.GuestPortal.MyServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="GuestOrderBadge" TargetType="Border" BasedOn="{StaticResource BadgeColumn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Pending">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Processing">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Completed">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Tải lại" Style="{StaticResource GhostButton}"
                    Padding="14,7" Command="{Binding ReloadCommand}" />
            <StackPanel>
                <TextBlock Text="Dịch vụ phòng" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Chọn món hoặc dịch vụ cần dùng trong thời gian lưu trú."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RoomText}" FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding StayText}" Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="LƯỢT LƯU TRÚ HIỆN TẠI" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="Dịch vụ chỉ được gửi tới phòng mà bạn đang nhận phòng."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <hc:LoadingCircle Width="34" Height="34" Panel.ZIndex="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{StaticResource BrandBrush}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520"
                        Visibility="{Binding HasActiveStay, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Chưa thể gọi dịch vụ" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource CaptionText}"
                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding HasActiveStay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="315" />
                </Grid.ColumnDefinitions>

                <!-- Thuc don + lich su -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" MinHeight="170" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DANH MỤC DỊCH VỤ"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />

                            <TextBlock DockPanel.Dock="Top" Text="Hiện chưa có dịch vụ đang mở bán."
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Visibility="{Binding MenuIsEmpty, Converter={StaticResource BoolToVis}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Menu}" Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                                           FontSize="12" Foreground="{StaticResource InkSoftBrush}"
                                                           Margin="2,0,0,5" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource GhostButton}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="10,8" Margin="0,0,0,4"
                                                                    Command="{Binding DataContext.AddItemCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="28" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}"
                                                                               FontWeight="SemiBold" Margin="12,0,12,0"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="+" FontSize="18"
                                                                               Foreground="{StaticResource BrandBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ĐƠN DỊCH VỤ CỦA TÔI"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top" Text="Bạn chưa gọi dịch vụ nào trong lượt ở này."
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Visibility="{Binding NoOrders, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                                <ItemsControl ItemsSource="{Binding Orders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock>
                                                            <Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  "/><Run Text="{Binding TimeText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ItemsText}" Style="{StaticResource CaptionText}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource GuestOrderBadge}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Gio hang -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="GIỎ DỊCH VỤ" Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,10" />

                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,10"
                                    Visibility="{Binding CartIsEmpty, Converter={StaticResource InverseBoolToVis}}" />
                            <DockPanel Margin="0,0,0,10"
                                       Visibility="{Binding CartIsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CartTotalText}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Tổng cộng" VerticalAlignment="Center" />
                            </DockPanel>
                            <Button Content="Gửi yêu cầu dịch vụ" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Padding="16,9"
                                    IsEnabled="{Binding CanSubmit}" Command="{Binding SubmitCommand}"
                                    Visibility="{Binding CartIsEmpty, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="Chọn một dịch vụ ở danh mục bên trái để thêm vào giỏ."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="12,12"
                                   Visibility="{Binding CartIsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButton}"
                                                            Padding="7,2" FontSize="14"
                                                            Command="{Binding DataContext.RemoveCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Margin="0,0,8,0" />
                                                </DockPanel>
                                                <DockPanel Margin="0,7,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="−" Style="{StaticResource GhostButton}" Padding="8,2"
                                                                Command="{Binding DataContext.DecreaseCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="+" Style="{StaticResource GhostButton}" Padding="8,2"
                                                                Command="{Binding DataContext.IncreaseCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="10,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
