<Window x:Class="FUHotelManagementWPF.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:FUHotelManagementWPF.ViewModels.GuestPortal"
        Title="FU Hotel - Phòng của tôi"
        Height="720" Width="1080"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh tren: logo + breadcrumb + chip khach + dang xuat -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="32" Height="32" CornerRadius="999"
                            Background="{StaticResource BrandBrush}">
                        <TextBlock Text="FU" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FU Hotel &amp; Resort" FontSize="15.5" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource CaptionText}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="22,1,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border CornerRadius="4" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="5,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="27" Height="27" CornerRadius="999"
                                    Background="{StaticResource BrandBrush}">
                                <TextBlock Text="{Binding AvatarInitial}" Foreground="White"
                                           FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,11,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GuestName}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Khách hàng" Style="{StaticResource CaptionText}" FontSize="10.5" />
                            </StackPanel>
                            <!-- Khach VIP: bao ngay tren thanh dau de biet minh dang co uu dai 10% -->
                            <Border Style="{StaticResource BadgeWarning}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="VIP −10%" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="Đăng xuất" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Than: sidebar gon 3 muc + vung noi dung -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,16,10,16">
                    <TextBlock Text="PHÒNG CỦA TÔI" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}" Opacity="0.9"
                               Margin="16,0,0,5" />
                    <ListBox ItemsSource="{Binding Menu}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource NavItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GuestMenuItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" />
                                    <TextBlock Text="{Binding Title}" Margin="11,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- BackdropHost: nen anh lam mo phia sau noi dung, dung chung voi MainWindow -->
            <ContentControl Grid.Column="1" Content="{Binding Current}"
                            Style="{StaticResource BackdropHost}" Focusable="False" />
        </Grid>

        <!-- Panel nhan thong bao Notify.* (Growl) -->
        <StackPanel Grid.Row="1" hc:Growl.GrowlParent="True"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,10,10,0" Panel.ZIndex="999" />
    </Grid>
</Window>
